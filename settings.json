{
  "defaultMode": "plan",
  "theme": "auto",
  "statusLine": {
    "type": "command",
    "command": "node ~/.claude/statusline.js"
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true
  },
  "permissions": {
    "deny": [
      "Bash(git push*)",
      "Bash(git reset*)",
      "Bash(git clean*)",
      "Bash(git commit*)",
      "PowerShell(git push*)",
      "PowerShell(git reset*)",
      "PowerShell(git clean*)",
      "PowerShell(git commit*)",
      "Read(*.env)",
      "Read(*.env.*)",
      "Read(env.*)",
      "Read(.env*)",
      "Edit(*.env)",
      "Edit(*.env.*)",
      "Edit(env.*)",
      "Edit(.env*)",
      "Grep(*.env)",
      "Grep(*.env.*)",
      "Grep(env.*)",
      "Grep(.env*)",
      "Read(credentials)",
      "Read(credentials.json)",
      "Read(secrets.yml)",
      "Read(secrets.yaml)",
      "Read(id_rsa)",
      "Read(id_ed25519)",
      "Read(.npmrc)",
      "Read(.netrc)",
      "Read(*.bak*)",
      "Edit(*.bak*)"
    ],
    "allow": [
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(git branch)",
      "Bash(git branch -v)",
      "Bash(git branch -vv)",
      "Bash(git remote -v)",
      "Bash(git blame*)",
      "Bash(git stash list*)",
      "PowerShell(git status*)",
      "PowerShell(git log*)",
      "PowerShell(git diff*)",
      "PowerShell(git show*)",
      "PowerShell(git branch)",
      "PowerShell(git branch -v)",
      "PowerShell(git branch -vv)",
      "PowerShell(git remote -v)",
      "PowerShell(git blame*)",
      "PowerShell(git stash list*)"
    ],
    "ask": [
      "Bash(git pull*)",
      "Bash(git fetch*)",
      "Bash(git checkout*)",
      "Bash(git restore*)",
      "Bash(git merge*)",
      "Bash(git rebase*)",
      "Bash(git cherry-pick*)",
      "Bash(git revert*)",
      "Bash(git add*)",
      "Bash(git rm*)",
      "Bash(git mv*)",
      "Bash(git branch -d*)",
      "Bash(git branch -D*)",
      "Bash(git branch -m*)",
      "Bash(git branch -M*)",
      "Bash(git stash pop*)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "Bash(git clone*)",
      "Bash(git init*)",
      "PowerShell(git pull*)",
      "PowerShell(git fetch*)",
      "PowerShell(git checkout*)",
      "PowerShell(git restore*)",
      "PowerShell(git merge*)",
      "PowerShell(git rebase*)",
