      "PowerShell(git revert*)",
      "PowerShell(git add*)",
      "PowerShell(git rm*)",
      "PowerShell(git mv*)",
      "PowerShell(git branch -d*)",
      "PowerShell(git branch -D*)",
      "PowerShell(git stash pop*)",
      "PowerShell(git stash drop*)",
      "PowerShell(git clone*)",
      "PowerShell(git init*)",
      "Bash(rm*)",
      "Bash(rmdir*)",
      "Bash(shred*)",
